// Villagers (SIM-10, SIM-11, SIM-12). Rates are per game day unless noted;
// a day is 2,400 ticks (calendar.ron).
(
    population: (
        // M2 populates one region at full detail; the rest wait for LOD (M5).
        // The run island ignores total, region and min_per_settlement: every
        // settlement there is populated at its drawn size (worldgen.ron sizes).
        total: 5000,
        // Region to populate: Auto = the region with the most settlements.
        region: Auto,
        min_per_settlement: 150,
    ),

    households: (
        // Household sizes 1..=7 and their relative weights.
        size_weights: [4, 10, 14, 16, 12, 8, 4],
        // Ages in years (a year is 120 days: four 30-day seasons).
        adult_age: (min: 18, max: 55),
        child_age: (min: 0, max: 15),
        elder_chance: 0.12,
        elder_age: (min: 56, max: 75),
        // Age from which villagers work, and after which they stop.
        working_age: (min: 16, max: 62),
    ),

    // Shares of working-age villagers, by occupation. Workers whose
    // workplace can't be built (no coast for fishers, say) become farmers,
    // or idle if there's no farm space either.
    occupations: [
        (occupation: Farmer, share: 0.45),
        (occupation: Fisher, share: 0.09),
        (occupation: Shepherd, share: 0.09),
        (occupation: Woodcutter, share: 0.05),
        (occupation: Miner, share: 0.03),
        (occupation: Smith, share: 0.04),
        (occupation: Baker, share: 0.07),
        (occupation: Carter, share: 0.14),
        (occupation: Idle, share: 0.04),
    ],

    needs: (
        hunger_per_day: 0.9,
        rest_lost_per_day_awake: 0.9,
        rest_gained_per_day_asleep: 2.4,
        // Thresholds on the 0..1 hunger scale.
        hungry: 0.4,
        starving: 0.85,
        // Eating stops once hunger is this low.
        sated: 0.05,
        meal_ticks: 40,
    ),

    // Utility AI (SIM-12). Each action scores weight x product of response
    // curves; the current action gets `inertia` added so agents don't flip
    // between near-equal options.
    ai: (
        decision_interval: 10,
        inertia: 0.08,
        eat: (weight: 1.15, hunger: Logistic(mid: 0.35, steepness: 14.0)),
        fetch: (weight: 0.7, home_stock_low: 1.0),
        sleep: (weight: 1.0, tiredness: Logistic(mid: 0.55, steepness: 10.0), night_drive: 0.8, night: 1.0, evening: 0.55, day: 0.05),
        work: (weight: 0.9, morning: 0.35, work: 1.0, evening: 0.02, night: 0.0),
        go_home: (weight: 0.45, evening: 1.0, night: 1.0, day: 0.0),
        idle: (weight: 0.12),
        // Reactions to armies (SIM-13), from the `safety` need (1 - the
        // settlement's threat level).
        flee: (weight: 1.3, fear: Logistic(mid: 0.6, steepness: 10.0), radius: 18.0, distance: 24),
        hide: (weight: 1.1, fear: Logistic(mid: 0.45, steepness: 10.0)),
        // Adults defend a provoked settlement if brave enough.
        fight: (weight: 1.4, courage: Logistic(mid: 0.55, steepness: 10.0), spread: 0.25, break_morale: 0.3),
        // Multiplier per tile of travel distance (prefers nearby options).
        distance_falloff: 0.006,
    ),

    movement: (
        // Tiles per tick on each terrain (10 ticks = 1 second at 1x).
        speed: (water: 0.0, beach: 0.11, grass: 0.13, farmland: 0.12, forest: 0.08, hills: 0.07, mountain: 0.04, road: 0.2),
        slope_cost: 1500.0,
    ),

    idle: (min_ticks: 60, max_ticks: 180, wander_radius: 6),

    // A civilian's fighting strength when defending their home (SIM-13).
    combat: (health: 60.0, attack: 5.0, defense: 0.0, morale: 0.6),

    // Loyalty to a settlement's owner (GP-06, SIM-24), 0..1. Each day it
    // closes `drift_per_day` of the gap to a target: under an owner, the
    // weighted mean of food security (days of food over `food_days`, capped
    // at 1), goodwill toward the owner ((g + 1) / 2) and time under the owner
    // (days over `settle_days`, capped at 1). Independent settlements aim at
    // `independent_target`, which is also every villager's starting loyalty.
    // A settlement whose mean is below `revolt_threshold` for a day may rise.
    loyalty: (
        // At the day tick, when the drift runs, a fed village holds about
        // 0.45 to 2 days of food (storehouse and homes; farm stock isn't
        // counted), so half a day is fully secure. The conquest scenario
        // (fed garrison rises, starved conquest revolts) guards it.
        food_days: 0.5,
        w_food: 0.55,
        w_goodwill: 0.3,
        w_time: 0.15,
        settle_days: 10.0,
        drift_per_day: 0.4,
        independent_target: 0.6,
        revolt_threshold: 0.35,
    ),

    // GP-22: word of a deed travels. Each goodwill change at a settlement
    // (a fair trade, a seizure, a killing, a request answered) also reaches
    // every other settlement whose centre lies within `spread_radius` tiles
    // of its centre, scaled by `spread_fraction`. Deltas per deed are in
    // progression.ron `goodwill_deeds`.
    goodwill: (
        spread_radius: 150.0,
        spread_fraction: 0.25,
    ),

    // Original names: given name + household family name.
    names: (
        given: [
            "Alda", "Bertil", "Corwen", "Dagna", "Edric", "Fenna", "Garrick", "Hilde", "Ivo", "Jorun",
            "Kael", "Liese", "Maddox", "Nell", "Osric", "Perrin", "Quilla", "Rowan", "Sabine", "Tobin",
            "Una", "Vesna", "Wendel", "Yara", "Aric", "Brenna", "Cedric", "Delia", "Emmet", "Freya",
            "Gisla", "Hollis", "Isolde", "Jory", "Kestrel", "Linnet", "Merrick", "Nyla", "Orla", "Piers",
            "Roswith", "Sten", "Tamsin", "Ulric", "Wilma", "Ansel", "Briony", "Cormac", "Dunstan", "Elspeth",
        ],
        family: [
            "Ashby", "Brook", "Cartwright", "Dunmore", "Ellis", "Fletcher", "Greaves", "Hale", "Ingram", "Jessop",
            "Kemp", "Lowe", "Marsh", "Noble", "Orme", "Pike", "Quarrie", "Reeve", "Stroud", "Thatcher",
            "Underhill", "Vane", "Ware", "Yeoman", "Barrow", "Cole", "Dyer", "Fenwick", "Garner", "Hayward",
            "Kettle", "Lockett", "Moss", "Nettleton", "Oakes", "Pryor", "Rook", "Sallow", "Tanner", "Woolley",
        ],
    ),

    // SIM-62 (M4a step 9): what a run town's site makes it. At populate, in a
    // run only, the first matching row wins: at least `min_tiles` reachable
    // tiles of `site` (economy.ron's site rules) within `radius` (40) of the
    // centre, counted before anything is built, and at least `road_degree`
    // roads meeting there. Its `shares` multiply the occupation shares above
    // before they are apportioned. An empty list turns specialties off.
    specialties: [
        (kind: Mining, site: Some(Upland), min_tiles: 150, road_degree: 0, radius: 40,
            shares: [(Miner, 4.0), (Smith, 2.0)]),
        (kind: Market, site: None, min_tiles: 0, road_degree: 3, radius: 40,
            shares: [(Carter, 1.3), (Baker, 1.3)]),
        (kind: Fishing, site: Some(Coast), min_tiles: 160, road_degree: 0, radius: 40,
            shares: [(Fisher, 2.5)]),
        (kind: Timber, site: Some(ForestEdge), min_tiles: 200, road_degree: 0, radius: 40,
            shares: [(Woodcutter, 3.0)]),
        (kind: Farming, site: None, min_tiles: 0, road_degree: 0, radius: 40,
            shares: [(Farmer, 1.1), (Baker, 1.2)]),
    ],
)
